# Ghostty — managed by ~/dotfiles. `ghostty +show-config --default --docs` for all options.
# The shell is your login shell (fish, set by `just setup shell`).

font-family = JetBrainsMono Nerd Font
font-size = 14
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

window-padding-x = 8
window-padding-y = 6
window-save-state = always
macos-option-as-alt = true
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false
shell-integration = detect
# over ssh: install the xterm-ghostty terminfo on the host (falls back to
# TERM=xterm-256color if it can't) and forward COLORTERM etc.
shell-integration-features = ssh-terminfo,ssh-env

background-opacity = 0.92
background-blur = 20

# --- Quick terminal (drop-down) -----------------------------------------------
# cmd+` from any app (global: needs macOS Accessibility permission; it takes over
# the system "next window of this app" shortcut while Ghostty is running)
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15
keybind = global:super+grave_accent=toggle_quick_terminal

# Machine-specific overrides (untracked, optional)
config-file = ?local.conf

# --- Mac-style text navigation ------------------------------------------------
# Same key codes as config/rex/init.lua; fish (functions/fish_user_key_bindings)
# and nvim (lua/config/keymaps.lua) turn them into movement and selection.
#   option+←/→  word        cmd+←/→  line start/end       (+shift = select)
#   option+⌫    delete word cmd+⌫    delete to line start
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
keybind = super+arrow_left=csi:H
keybind = super+arrow_right=csi:F
keybind = super+backspace=text:\x15
keybind = alt+shift+arrow_left=csi:1;4D
keybind = alt+shift+arrow_right=csi:1;4C
keybind = super+shift+arrow_left=csi:1;2H
keybind = super+shift+arrow_right=csi:1;2F
# shift+arrows extend a mouse selection only when one exists; otherwise they go to the app
keybind = performable:shift+arrow_left=adjust_selection:left
keybind = performable:shift+arrow_right=adjust_selection:right
