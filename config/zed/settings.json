// Zed settings — managed by ~/dotfiles.
// `zed: open default settings` in the command palette shows every option.
{
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "terminal": {
    "shell": { "program": "fish" },
    "font_family": "JetBrainsMono Nerd Font"
  },
  "format_on_save": "on",
  "relative_line_numbers": true,
  "telemetry": { "diagnostics": false, "metrics": false }
}
