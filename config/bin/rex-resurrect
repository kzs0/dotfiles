#!/usr/bin/env python3
"""rex-resurrect — bring back what each Rex pane was running after the Rex
server restarts.

Rex already restores sessions, windows, panes and their working directories,
but every pane comes back as a fresh shell. This daemon fills that gap, the
same way tmux-resurrect / tmux-assistant-resurrect / zellij do:

  * snapshot: every few seconds, ask Rex for each pane's foreground process
    and work out what's running *right now*. For coding agents, the exact
    conversation is resolved from the live process, so moving panes,
    /resume-ing or /clear-ing is always picked up on the next snapshot:
        claude  ~/.claude/sessions/<pid>.json         (written by Claude Code)
        codex   ~/.codex/session-tags.jsonl  pid→id   (written by Codex)
        pi      --session arg, else the session file it is writing to
  * restore: when the server's instance id changes (it restarted), type the
    resume command into each restored pane. Agents are resumed automatically
    (`claude --resume <id>`, `codex resume <id>`, `pi --session <file>`);
    anything else is typed but NOT run — press Enter if you want it
    (like zellij's "Press ENTER to run").

If a conversation can't be identified exactly, the agent starts fresh rather
than guessing (no --continue / --last).

usage: rex-resurrect daemon | snapshot | restore [--dry-run] | status
"""

import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time

POLL_SECONDS = 5
# a pane must show "nothing running" this long before its entry is dropped;
# a server shutdown kills programs first, and we stop polling once it's gone,
# so entries survive the shutdown window
GONE_GRACE_SECONDS = 20
PROMPT_WAIT_SECONDS = 30

SHELLS = {"fish", "zsh", "bash", "sh", "dash", "nu", "login"}
AGENTS = {"claude", "codex", "pi"}
# flags (with their arity) that are safe to carry over on resume. Everything
# else is dropped — positional args are usually a prompt, and replaying a
# prompt would send it again.
KEEP_FLAGS = {
    "claude": {"--model": 1, "--permission-mode": 1, "--dangerously-skip-permissions": 0,
               "--add-dir": 1, "--agent": 1, "--mcp-config": 1, "--chrome": 0, "--ide": 0},
    "codex": {"--model": 1, "-m": 1, "--sandbox": 1, "-s": 1, "--ask-for-approval": 1, "-a": 1,
              "--full-auto": 0, "--dangerously-bypass-approvals-and-sandbox": 0, "--search": 0,
              "--profile": 1, "-p": 1},
    "pi": {"--model": 1, "--provider": 1, "--thinking": 1, "--tools": 1, "-t": 1,
           "--models": 1, "--no-tools": 0, "-nt": 0},
}

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local", "state")),
                         "rex-resurrect")
SERVER = os.environ.get("REX_RESURRECT_SERVER")  # optional -S target (used by tests)


def log(*a):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), *a, flush=True)


# --------------------------------------------------------------------------
# rex CLI
# --------------------------------------------------------------------------

def rex(*args, check=True):
    cmd = ["rex", "--autostart=false", "--timeout", "5s"]
    if SERVER:
        cmd += ["-S", SERVER]
    cmd += list(args)
    p = subprocess.run(cmd, capture_output=True, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {p.stderr.strip()}")
    return p.stdout


def server_status():
    try:
        return json.loads(rex("server", "status", "--json"))
    except Exception:
        return None


def panes():
    """Yield (session_id, block_id) for every terminal pane on the server."""
    for s in json.loads(rex("ls", "--json")).get("sessions", []):
        sid = s["session_id"]
        for b in json.loads(rex("block", "ls", "-s", sid, "--json", "--short=false")).get("blocks", []):
            if b.get("creator_name") == "com.superlogical.terminal":
                yield sid, b["block_id"]


def pane_process(sid, bid):
    return json.loads(rex("block", "call", "-s", sid, "-b", bid, "process", "{}"))


# --------------------------------------------------------------------------
# process helpers
# --------------------------------------------------------------------------

def ps_args(pid):
    p = subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True)
    return p.stdout.strip()


def ps_start(pid):
    p = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True,
                       env={**os.environ, "LC_ALL": "C"})
    try:
        return time.mktime(time.strptime(p.stdout.strip(), "%a %b %d %H:%M:%S %Y"))
    except ValueError:
        return 0.0


def program_of(proc):
    """Return (kind, pid, argv) for the program a pane is running, or None."""
    chain = [proc.get("foreground") or {}] + list(proc.get("ancestors") or [])
    shell_pids = set()
    candidates = []
    for p in chain:
        if not p.get("pid"):
            continue
        name = os.path.basename(p.get("argv0") or p.get("invoked_path") or p.get("name") or "").lstrip("-")
        if name in SHELLS:
            shell_pids.add(p["pid"])
            continue
        argv = ps_args(p["pid"]).split()
        if not argv:
            continue
        # node/bun scripts: `node /…/bin/pi …` → pi
        if name in ("node", "bun") and len(argv) > 1:
            script = os.path.basename(argv[1])
            if script == "pi" or "pi-coding-agent" in argv[1]:
                name, argv = "pi", ["pi"] + argv[2:]
        candidates.append((name, p["pid"], argv, p.get("cwd")))
    if not candidates:
        return None
    # prefer an agent anywhere in the chain (an agent's tool subprocess may be
    # the foreground process); otherwise the program closest to the shell
    for c in candidates:
        if c[0] in AGENTS:
            return c
    return candidates[-1]


def kept_flags(kind, argv):
    keep, spec, i = [], KEEP_FLAGS.get(kind, {}), 1
    while i < len(argv):
        a = argv[i]
        flag, _, inline = a.partition("=")
        if flag in spec:
            if inline or spec[flag] == 0:
                keep.append(a)
            elif i + 1 < len(argv):
                keep += [a, argv[i + 1]]
                i += 1
        i += 1
    return keep


def arg_value(argv, *names):
    for i, a in enumerate(argv):
        for n in names:
            if a == n and i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                return argv[i + 1]
            if a.startswith(n + "="):
                return a.split("=", 1)[1]
    return None


# --------------------------------------------------------------------------
# agent session resolution
# --------------------------------------------------------------------------

def claude_session(pid, argv):
    root = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))
    try:
        with open(os.path.join(root, "sessions", f"{pid}.json")) as f:
            return json.load(f).get("sessionId")
    except (OSError, ValueError):
        return arg_value(argv, "--resume", "-r", "--session-id")


def codex_session(pid, argv):
    root = os.environ.get("CODEX_HOME", os.path.join(HOME, ".codex"))
    sid = None
    try:
        with open(os.path.join(root, "session-tags.jsonl")) as f:
            for line in f:
                if f'"pid":{pid},' in line.replace(" ", "") or f'"pid":{pid}}}' in line.replace(" ", ""):
                    try:
                        sid = json.loads(line).get("session") or sid
                    except ValueError:
                        pass
    except OSError:
        pass
    if sid:
        return sid
    if "resume" in argv:
        i = argv.index("resume")
        if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            return argv[i + 1]
    return None


def pi_session(pid, argv, cwd, claimed):
    sid = arg_value(argv, "--session")
    if sid:
        return sid
    root = os.environ.get("PI_CODING_AGENT_SESSION_DIR",
                          os.path.join(os.environ.get("PI_CODING_AGENT_DIR", os.path.join(HOME, ".pi", "agent")),
                                       "sessions"))
    if not cwd:
        return None
    d = os.path.join(root, "--" + cwd.strip("/").replace("/", "-").replace(":", "-") + "--")
    started = ps_start(pid)
    best = None
    try:
        for fn in os.listdir(d):
            if not fn.endswith(".jsonl"):
                continue
            path = os.path.join(d, fn)
            m = os.path.getmtime(path)
            # pi appends to its session file as it goes, so the file this
            # process is using was modified during its lifetime
            if m + 2 >= started and path not in claimed and (best is None or m > best[0]):
                best = (m, path)
    except OSError:
        return None
    return best[1] if best else None


def resume_command(kind, argv, session):
    flags = " ".join(shlex.quote(a) for a in kept_flags(kind, argv))
    flags = (flags + " ") if flags else ""
    if kind == "claude":
        return f"claude {flags}--resume {shlex.quote(session)}" if session else f"claude {flags}".strip()
    if kind == "codex":
        return f"codex {flags}resume {shlex.quote(session)}" if session else f"codex {flags}".strip()
    if kind == "pi":
        return f"pi {flags}--session {shlex.quote(session)}" if session else f"pi {flags}".strip()
    return " ".join(shlex.quote(a) for a in argv)


# --------------------------------------------------------------------------
# state
# --------------------------------------------------------------------------

def state_path(status):
    key = hashlib.sha1(status["endpoint"].encode()).hexdigest()[:12]
    return os.path.join(STATE_DIR, f"{key}.json")


def load_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"instance_id": None, "panes": {}}


def save_state(path, state):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, path)


def snapshot(state):
    now = time.time()
    seen, claimed = set(), set()
    for sid, bid in panes():
        try:
            prog = program_of(pane_process(sid, bid))
        except Exception:
            continue
        if not prog:
            continue
        kind, pid, argv, cwd = prog
        session = None
        if kind == "claude":
            session = claude_session(pid, argv)
        elif kind == "codex":
            session = codex_session(pid, argv)
        elif kind == "pi":
            session = pi_session(pid, argv, cwd, claimed)
            if session:
                claimed.add(session)
        if kind not in AGENTS and argv and os.path.basename(argv[0]) in SHELLS:
            continue
        state["panes"][bid] = {
            "session": sid, "kind": kind if kind in AGENTS else "command",
            "cwd": cwd, "agent_session": session,
            "resume": resume_command(kind, argv, session),
            "auto": kind in AGENTS, "seen": now, "gone_since": None,
        }
        seen.add(bid)
    for bid, p in list(state["panes"].items()):
        if bid in seen:
            continue
        if p.get("gone_since") is None:
            p["gone_since"] = now
        elif now - p["gone_since"] > GONE_GRACE_SECONDS:
            del state["panes"][bid]


def wait_for_prompt(sid, bid):
    deadline = time.time() + PROMPT_WAIT_SECONDS
    while time.time() < deadline:
        try:
            proc = pane_process(sid, bid)
            if program_of(proc) is None:
                return proc
        except Exception:
            pass
        time.sleep(1)
    return None


def restore(state, dry_run=False):
    live = {bid: sid for sid, bid in panes()}
    for bid, p in state["panes"].items():
        sid = live.get(bid)
        if not sid:
            log("skip (pane gone):", bid, p["resume"])
            continue
        proc = {} if dry_run else wait_for_prompt(sid, bid)
        if proc is None:
            log("skip (pane busy):", bid, p["resume"])
            continue
        cmd = p["resume"]
        here = ((proc or {}).get("foreground") or {}).get("cwd")
        if p.get("cwd") and here and here != p["cwd"] and os.path.isdir(p["cwd"]):
            cmd = f"cd {shlex.quote(p['cwd'])}; and {cmd}"
        log(("would " if dry_run else "") + ("run" if p["auto"] else "type"), f"[{bid}]", cmd)
        if dry_run:
            continue
        rex("send", "-s", sid, "-b", bid, cmd)
        if p["auto"]:
            rex("send-key", "-s", sid, "-b", bid, "enter")


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def cmd_daemon():
    log("rex-resurrect daemon started")
    while True:
        status = server_status()
        if not status:
            time.sleep(POLL_SECONDS)
            continue
        path = state_path(status)
        state = load_state(path)
        try:
            if state.get("instance_id") != status["instance_id"]:
                if state.get("instance_id") and state["panes"]:
                    log(f"server restarted ({state['instance_id']} -> {status['instance_id']}); restoring")
                    time.sleep(2)  # let restored shells start
                    restore(state)
                state["instance_id"] = status["instance_id"]
                save_state(path, state)
                time.sleep(POLL_SECONDS)  # let resumed programs start before snapshotting
                continue
            snapshot(state)
            # only commit if the server we snapshotted is still the same one
            again = server_status()
            if again and again["instance_id"] == status["instance_id"]:
                save_state(path, state)
        except Exception as e:  # server went away mid-snapshot, etc.
            log("error:", e)
        time.sleep(POLL_SECONDS)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    status = server_status()
    if cmd == "daemon":
        return cmd_daemon()
    if not status:
        sys.exit("rex server is not running")
    path = state_path(status)
    state = load_state(path)
    if cmd == "snapshot":
        snapshot(state)
        state.setdefault("instance_id", status["instance_id"])
        save_state(path, state)
        cmd = "status"
    if cmd == "restore":
        return restore(state, dry_run="--dry-run" in sys.argv)
    if cmd == "status":
        print(f"server {status['instance_id']}  state {path}")
        for bid, p in state["panes"].items():
            mark = "auto " if p["auto"] else "enter"
            gone = "  (gone)" if p.get("gone_since") else ""
            print(f"  {mark}  {bid[-12:]}  {p['resume']}{gone}")
        return
    sys.exit(__doc__)


if __name__ == "__main__":
    main()
